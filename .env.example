# HealthPass Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or real credentials to Git!

# MongoDB Atlas connection string
# Format: mongodb+srv://<db_username>:<db_password>@<cluster-url>/healthpass?retryWrites=true&w=majority
# If omitted during local development or testing, HealthPass automatically falls back
# to an isolated In-Memory MongoDB instance without losing any API features.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/healthpass?retryWrites=true&w=majority

# Backend Server Port (default: 5000)
PORT=5000

# JSON Web Token secret for signing authentication sessions & safe QR identification tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-secure-random-secret-key-in-production

# Token lifetime (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# Environment: 'development' or 'production'
# In production, cookies are enforced with secure: true
NODE_ENV=development

# Frontend application URL for CORS
CORS_ORIGIN=http://localhost:3000

# Optional: AI Report Explanation Service Port (default: 5001)
REPORT_AI_PORT=5001

# Optional: Google Gemini API Key for upstream clinical report explanations
GEMINI_API_KEY=
